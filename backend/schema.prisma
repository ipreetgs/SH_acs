datasource db {\n  provider = "postgresql"\n  url      = env("DATABASE_URL")\n}\n\ngenerator client {\n  provider = "prisma-client-js"\n}\n\nmodel User {\n  id        String   @id @default(uuid())\n  email     String   @unique\n  password  String\n  homes     Home[]\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n}\n\nmodel Home {\n  id        String   @id @default(uuid())\n  name      String\n  ownerId   String\n  owner     User     @relation(fields: [ownerId], references: [id])\n  rooms     Room[]\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n}\n\nmodel Room {\n  id        String   @id @default(uuid())\n  name      String\n  homeId    String\n  home      Home     @relation(fields: [homeId], references: [id])\n  devices   Device[]\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n}\n\nmodel Device {\n  id            String      @id @default(uuid())\n  matterNodeId  String      @unique // 64-bit Node ID assigned by Matter Fabric\n  fabricId      String      // Identity of the ecosystem\n  name          String\n  roomId        String\n  room          Room        @relation(fields: [roomId], references: [id])\n  firmwareVer   String      @default("1.0.0")\n  isOnline      Boolean     @default(false)\n  telemetry     Telemetry[]\n  createdAt     DateTime    @default(now())\n  updatedAt     DateTime    @updatedAt\n}\n\nmodel Telemetry {\n  id         String   @id @default(uuid())\n  deviceId   String\n  device     Device   @relation(fields: [deviceId], references: [id])\n  rssi       Int\n  tempC      Float\n  uptimeSecs Int\n  recordedAt DateTime @default(now())\n}\n\nmodel FirmwareOTA {\n  id           String   @id @default(uuid())\n  version      String   @unique\n  fileUrl      String   // S3 or local bucket link to firmware.bin\n  releaseNotes String\n  targetFabric String?  // Optional targeted rollout\n  createdAt    DateTime @default(now())\n}\n
